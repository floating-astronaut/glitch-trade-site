---
import Icon from '~/components/Icon.astro';
import { faqs } from '~/lib/marketing';
---

<section id="faq" class="py-12 md:py-16 lg:py-20 border-t border-border/40">
  <div class="container-app grid gap-10 md:grid-cols-12">
    <div class="md:col-span-4 reveal">
      <p class="eyebrow"><Icon name="spark" size={14} /> FAQ</p>
      <h2 class="mt-4">The trust questions should be answered on the page.</h2>
      <p class="mt-5 text-fluid-base text-muted">The new copy should remove the usual friction fast: no alpha claims, no custody confusion, no “is this just for prop firms?” misunderstanding.</p>
    </div>

    <div class="md:col-span-8">
      <ul class="divide-y divide-border/60 border-y border-border/60" role="list">
        {faqs.map((faq) => (
          <li>
            <details class="group">
              <summary class="flex items-start justify-between gap-4 py-5 cursor-pointer list-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-md">
                <span class="text-fluid-base font-medium pr-2">{faq.q}</span>
                <span aria-hidden="true" class="shrink-0 mt-1 size-6 inline-flex items-center justify-center rounded-full border border-border text-subtle transition-transform duration-200 group-open:rotate-45 group-open:text-brand group-open:border-brand/50">
                  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                    <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  </svg>
                </span>
              </summary>
              <div class="pb-5 pr-8 text-fluid-sm text-muted leading-relaxed">{faq.a}</div>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
