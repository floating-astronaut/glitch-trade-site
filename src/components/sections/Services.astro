---
import Icon from '~/components/Icon.astro';
import { personas } from '~/lib/marketing';
---

<section id="personas" class="py-12 md:py-16 lg:py-20 border-y border-border/40 bg-surface/28">
  <div class="container-app">
    <div class="max-w-3xl reveal">
      <p class="eyebrow"><Icon name="target" size={14} /> Built for a spectrum</p>
      <h2 class="mt-4">The audience is broader now on purpose.</h2>
      <p class="mt-5 max-w-[60ch] text-fluid-lg text-muted">
        The old site read like a niche prop-firm product. The locked rev 4 positioning is wider: a simple rule, a webhook trader, a prop challenge operator, and a quant can all land on the same platform and use different depths of the same system.
      </p>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      {personas.map((persona) => (
        <article class="card reveal h-full p-6">
          <p class="font-mono text-fluid-xs uppercase tracking-[0.18em] text-brand">Persona</p>
          <h3 class="mt-4 text-fluid-xl">{persona.name}</h3>
          <p class="mt-4 text-fluid-sm text-fg/90">{persona.pain}</p>
          <div class="mt-5 rounded-xl border border-border/60 bg-bg/60 p-4 text-fluid-xs text-subtle">
            {persona.fit}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
