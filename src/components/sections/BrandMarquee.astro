---
import { brokers } from '~/lib/marketing';
---

<section aria-label="Supported broker paths" class="py-6 md:py-8 border-y border-border/40 bg-surface/25">
  <div class="container-app">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <p class="eyebrow">Supported broker paths</p>
        <p class="mt-2 max-w-2xl text-fluid-sm text-muted">Broker support advertised in the locked positioning: cTrader, TradeLocker, DXtrade, and MT4 / MT5 via MetaApi.</p>
      </div>
      <p class="max-w-xl text-fluid-xs text-subtle">We never trade on your behalf. cTrader uses read-only OAuth. Other brokers: password exchanged once for a refresh token, then discarded.</p>
    </div>

    <div class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
      {brokers.map((broker) => (
        <div class="rounded-2xl border border-border/70 bg-bg/70 px-4 py-4 backdrop-blur-sm">
          <p class="font-mono text-fluid-xs uppercase tracking-[0.18em] text-brand">{broker.short}</p>
          <p class="mt-2 text-fluid-lg font-semibold text-fg">{broker.name}</p>
        </div>
      ))}
    </div>
  </div>
</section>
