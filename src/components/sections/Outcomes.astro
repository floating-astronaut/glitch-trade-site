---
import Icon from '~/components/Icon.astro';
import { verbs } from '~/lib/marketing';
---

<section id="platform" class="py-12 md:py-16 lg:py-20">
  <div class="container-app">
    <div class="max-w-3xl reveal">
      <p class="eyebrow"><Icon name="layers" size={14} /> The product in three verbs</p>
      <h2 class="mt-4">Run first, test second, track continuously.</h2>
      <p class="mt-5 max-w-[62ch] text-fluid-lg text-muted">
        The order matters. First you get the automation running. Then you test it on past candles. Then you keep the live account view clean enough to act on. Firm Mode sits inside that loop as a differentiator, not as the whole story.
      </p>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {verbs.map((verb, index) => (
        <article class="card reveal p-6 md:p-7" style={`transition-delay:${index * 80}ms`}>
          <div class="inline-flex items-center gap-3 rounded-full border border-brand/25 bg-brand/10 px-3 py-1 text-brand">
            <span class="font-mono text-fluid-xs uppercase tracking-[0.18em]">{verb.name}</span>
          </div>
          <h3 class="mt-5">{verb.title}</h3>
          <p class="mt-4 text-fluid-sm text-muted">{verb.detail}</p>
          <p class="mt-4 rounded-xl border border-border/60 bg-bg/60 p-4 text-fluid-xs text-subtle">{verb.example}</p>
        </article>
      ))}
    </div>
  </div>
</section>
