---
import Icon from '~/components/Icon.astro';

// Honest capability stats (not performance claims). All four lifted verbatim
// from the legacy site's "stats bar" above the fold — every number describes
// what the system *does*, not what returns it produced. That keeps us clear
// of securities-advertising rules.
const outcomes = [
  {
    icon: 'cpu' as const,
    metric: '9',
    label: 'Specialized models',
    context: 'Trend, mean-reversion, momentum, ML predictor, multi-TF, volume, session, sentiment, aggregator',
  },
  {
    icon: 'link' as const,
    metric: '100+',
    label: 'Supported exchanges',
    context: 'Via CCXT · Binance, OKX, Bybit, KuCoin, Coinbase, Bitget, MEXC, Gate.io, Kraken +',
  },
  {
    icon: 'bolt' as const,
    metric: '< 5s',
    label: 'Signal to Telegram',
    context: 'From candle close to ensemble consensus to your phone — in under five seconds',
  },
  {
    icon: 'shield' as const,
    metric: '24/7',
    label: 'Autonomous monitoring',
    context: 'Ensemble fires only above a confidence threshold — low-conviction setups suppressed',
  },
];
---

<section id="outcomes" class="py-20 md:py-28 border-y border-border/40 bg-surface/30">
  <div class="container-app">
    <div class="max-w-2xl reveal">
      <p class="eyebrow"><Icon name="bolt" size={14} /> What the system does</p>
      <h2 class="mt-4">Nine lenses on every candle. One decision to act on.</h2>
      <p class="mt-4 text-fluid-base text-muted">
        Each model specializes in a different market read. They vote. The ensemble
        decides. You get a single signal — not nine conflicting indicators.
      </p>
    </div>

    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" role="list">
      {outcomes.map((o) => (
        <li class="card p-6 reveal">
          <span class="inline-flex size-9 items-center justify-center rounded-md bg-brand/10 text-brand border border-brand/20">
            <Icon name={o.icon} size={18} />
          </span>
          <div class="mt-4 font-mono text-fluid-3xl text-brand leading-none">{o.metric}</div>
          <div class="mt-2 text-fluid-sm font-medium">{o.label}</div>
          <p class="mt-3 text-fluid-xs text-subtle leading-relaxed">{o.context}</p>
        </li>
      ))}
    </ul>

    <p class="mt-10 text-fluid-xs text-subtle max-w-2xl reveal">
      Trading involves risk. Nothing on this page is financial advice.
      Past performance of any model or strategy does not guarantee future results.
    </p>
  </div>
</section>
