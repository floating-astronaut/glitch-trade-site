---
import Icon from '~/components/Icon.astro';
import { appLinks } from '~/lib/marketing';
---

<section id="contact" class="py-12 md:py-16 lg:py-20">
  <div class="container-app">
    <div class="card reveal overflow-hidden border-brand/30 bg-[linear-gradient(180deg,rgb(var(--color-surface-2)/0.7),rgb(var(--color-bg)/0.9))] p-8 md:p-12 lg:p-16">
      <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div>
          <p class="eyebrow"><Icon name="send" size={14} /> Start in the app</p>
          <h2 class="mt-4">The marketing page should end at the right next step.</h2>
          <p class="mt-5 max-w-[60ch] text-fluid-lg text-muted">
            Open the app if you want to start free. Open the quick route if you already have a trade idea. That maps directly to the locked positioning: run it, test it, track it.
          </p>
        </div>

        <div class="grid gap-3 lg:justify-self-end lg:min-w-[20rem]">
          <a href={appLinks.signup} class="btn btn-primary justify-center" data-cta="final-start-free">
            Start free in the app
            <Icon name="arrow-up-right" size={16} />
          </a>
          <a href={appLinks.quick} class="btn btn-ghost justify-center" data-cta="final-quick-rule">
            Try a quick rule
            <Icon name="arrow-up-right" size={16} />
          </a>
          <p class="text-center text-fluid-xs text-subtle">trade-app.glitchexecutor.com</p>
        </div>
      </div>
    </div>
  </div>
</section>
