---
import Icon from '~/components/Icon.astro';
import ContactForm from '~/components/ContactForm.astro';
import { site } from '~/lib/site';
---

<section id="contact" class="py-8 md:py-10 lg:py-12 relative">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 mask-fade-b">
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand/40 to-transparent"></div>
  </div>

  <div class="container-app grid md:grid-cols-12 gap-10">
    <div class="md:col-span-5 reveal">
      <p class="eyebrow"><Icon name="send" size={14} /> Request a trial key</p>
      <h2 class="mt-4">Seven days. No card. Full toolkit.</h2>
      <p class="mt-5 text-fluid-lg text-muted">
        Drop your details and we'll issue a trial key within one business day.
        Prefer email? <a href={`mailto:${site.contactEmail}`} class="text-brand underline decoration-brand/40 hover:decoration-brand">{site.contactEmail}</a>.
      </p>

      <ul class="mt-8 space-y-3 text-fluid-sm text-muted">
        <li class="flex items-start gap-2">
          <span class="mt-[3px] text-brand"><Icon name="check" size={14} /></span>
          We ship tools; you run your book. No managed-service retainer, no advisory relationship.
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-[3px] text-brand"><Icon name="check" size={14} /></span>
          Your exchange keys and capital stay on your own infrastructure — we never touch them.
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-[3px] text-brand"><Icon name="check" size={14} /></span>
          30-day evaluation window with a refund if the tools didn't fit your desk.
        </li>
      </ul>
    </div>

    <div class="md:col-span-7 reveal">
      <ContactForm />
    </div>
  </div>
</section>
