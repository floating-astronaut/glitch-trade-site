---
import Icon from '~/components/Icon.astro';
import { tiers, appLinks } from '~/lib/marketing';
---

<section id="pricing-preview" class="py-12 md:py-16 lg:py-20 border-y border-border/40 bg-surface/24">
  <div class="container-app">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between reveal">
      <div class="max-w-3xl">
        <p class="eyebrow"><Icon name="bolt" size={14} /> Locked pricing</p>
        <h2 class="mt-4">Four tiers, one marketplace, no invented upsells.</h2>
        <p class="mt-5 text-fluid-lg text-muted">
          The floor is low enough for a casual trader. The ceiling is high enough for a quant workflow. Marketplace authors keep 70% when they sell strategies; Glitch Trade takes 30%.
        </p>
      </div>
      <a href="/pricing" class="inline-flex items-center gap-2 text-fluid-sm text-brand hover:text-electric">See full pricing table <Icon name="arrow-up-right" size={14} /></a>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      {tiers.map((tier) => (
        <article class={`card reveal h-full p-6 ${tier.featured ? 'border-brand/40 bg-brand/8' : ''}`}>
          <p class="font-mono text-fluid-xs uppercase tracking-[0.18em] text-brand">{tier.name}</p>
          <div class="mt-4 flex items-end gap-1">
            <span class="font-mono text-fluid-3xl text-fg">{tier.price}</span>
            <span class="text-fluid-sm text-subtle">{tier.cadence}</span>
          </div>
          <p class="mt-4 text-fluid-sm text-muted">{tier.audience}</p>
          <ul class="mt-5 space-y-2 text-fluid-sm text-fg/90">
            {tier.features.map((feature) => (
              <li class="flex items-start gap-2"><span class="mt-[5px] size-1.5 rounded-full bg-brand"></span><span>{feature}</span></li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="mt-8 flex flex-wrap gap-3 reveal">
      <a href={appLinks.signup} class="btn btn-primary" data-cta="pricing-preview-start-free">
        Start free
        <Icon name="arrow-up-right" size={16} />
      </a>
      <a href={appLinks.quick} class="btn btn-ghost" data-cta="pricing-preview-quick-rule">
        Try a quick rule
        <Icon name="arrow-up-right" size={16} />
      </a>
    </div>
  </div>
</section>
