---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import { appLinks, tiers, comparisonRows } from '~/lib/marketing';
---

<Base title="Pricing" description="Glitch Trade pricing across Free, Pro, Pro+, and Pro Quant." pageType="WebPage" ogSlug="pricing">
  <section class="py-12 md:py-16 lg:py-20">
    <div class="container-app">
      <p class="eyebrow"><Icon name="bolt" size={14} /> Pricing</p>
      <h1 class="mt-4 max-w-[16ch]">Four tiers locked to the rev 4 product shape.</h1>
      <p class="mt-6 max-w-[62ch] text-fluid-lg text-muted">The tiers are already decided: Free for the first rule, Pro for the visual workflow, Pro+ for full strategy authoring and Firm Mode depth, Pro Quant for teams that need API access and future hosted execution.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={appLinks.signup} class="btn btn-primary" data-cta="pricing-start-free">Start free<Icon name="arrow-up-right" size={16} /></a>
        <a href={appLinks.quick} class="btn btn-ghost" data-cta="pricing-quick-rule">Try a quick rule<Icon name="arrow-up-right" size={16} /></a>
      </div>
    </div>
  </section>

  <section class="pb-12 md:pb-16">
    <div class="container-app grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      {tiers.map((tier) => (
        <article class={`card p-6 ${tier.featured ? 'border-brand/40 bg-brand/8' : ''}`}>
          <p class="font-mono text-fluid-xs uppercase tracking-[0.18em] text-brand">{tier.name}</p>
          <div class="mt-4 flex items-end gap-1">
            <span class="font-mono text-fluid-4xl text-fg">{tier.price}</span>
            <span class="text-fluid-sm text-subtle">{tier.cadence}</span>
          </div>
          <p class="mt-4 text-fluid-sm text-muted">{tier.audience}</p>
          <ul class="mt-5 space-y-2 text-fluid-sm text-fg/90">
            {tier.features.map((feature) => <li class="flex items-start gap-2"><span class="mt-[5px] size-1.5 rounded-full bg-brand"></span><span>{feature}</span></li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="pb-12 md:pb-16 lg:pb-20">
    <div class="container-app">
      <div class="max-w-3xl">
        <p class="eyebrow"><Icon name="layers" size={14} /> Feature comparison</p>
        <h2 class="mt-4">What changes at each level.</h2>
        <p class="mt-5 text-fluid-base text-muted">This table mirrors the locked pricing decisions exactly. No hidden enterprise tier, no made-up performance promises, no shift back into a niche prop-only pitch.</p>
      </div>
      <div class="mt-8 overflow-x-auto rounded-2xl border border-border/60">
        <table class="min-w-full border-collapse text-left text-fluid-sm">
          <thead class="bg-surface-2/70 text-fluid-xs uppercase tracking-[0.18em] text-subtle">
            <tr>
              <th class="px-4 py-3 font-medium">Feature</th>
              {tiers.map((tier) => <th class="px-4 py-3 font-medium">{tier.name}</th>)}
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr class="border-t border-border/60 bg-bg/55 align-top">
                <th class="px-4 py-4 font-semibold text-fg">{row.label}</th>
                {row.values.map((value) => <td class="px-4 py-4 text-muted">{value}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-5 text-fluid-sm text-subtle">Marketplace rev share is 30% to Glitch Trade and 70% to the strategy author.</p>
    </div>
  </section>
</Base>
