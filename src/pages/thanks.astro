---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import Mascot from '~/components/Mascot.astro';
---

<Base
  title="Thanks"
  description="Your message reached Glitch Trade."
  noindex
  pageType="WebPage"
>
  <section class="container-app min-h-[60vh] flex items-center py-24">
    <div class="grid gap-6 max-w-xl reveal">
      <Mascot size={72} priority alt="" />
      <p class="eyebrow"><Icon name="check" size={14} /> Message received</p>
      <h1>Thanks.</h1>
      <p class="text-fluid-lg text-muted">
        Start in the app when you are ready. If you reached out with a question, reply to the confirmation email and we will pick it up there.
      </p>
      <div class="flex gap-3">
        <a href="https://trade-app.glitchexecutor.com" class="btn btn-primary" data-cta="thanks-start-free">
          Start free <Icon name="arrow-up-right" size={16} />
        </a>
        <a href="https://trade-app.glitchexecutor.com/quick" class="btn btn-ghost" data-cta="thanks-quick-rule">
          Try a quick rule <Icon name="arrow-up-right" size={16} />
        </a>
      </div>
    </div>
  </section>
</Base>
